#. Plugin Name of the plugin
#: atesto.php
msgid "Atesto - Social Proof for WooCommerce"
msgstr "Proof - Społeczny dowód słuszności dla WooCommerce"

#. Plugin URI of the plugin
#: atesto.php
msgid "https://plogins.com/plogins-proof/"
msgstr "https://plogins.com/plogins-proof/"

#. Description of the plugin
#: atesto.php
msgid "Show recent-sale social-proof popups to build trust and urgency."
msgstr ""
"Wyświetlaj wyskakujące powiadomienia o niedawnych zakupach (społeczny dowód "
"słuszności), aby budować zaufanie i poczucie pilności."

#. Author of the plugin
#: atesto.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

#. Author URI of the plugin
#: atesto.php
msgid "https://wppoland.com"
msgstr "https://wppoland.com"

#: atesto.php:48
msgid "Atesto requires WooCommerce to be active."
msgstr "Proof wymaga aktywnego WooCommerce."

#: src/Admin/ProUpsell.php:78
msgid "Wkrótce"
msgstr "Wkrótce"

#: src/Admin/ProUpsell.php:78
msgid "Coming soon"
msgstr "Wkrótce"

#. translators: 1: currency symbol, 2: yearly price
#: src/Admin/ProUpsell.php:84
#, php-format
msgid "from %1$s%2$d/yr"
msgstr "od %1$s%2$d/rok"

#: src/Admin/ProUpsell.php:93
msgid "Upgrade to PRO"
msgstr "Przejdź na PRO"

#: src/Admin/ProUpsell.php:94
msgid "Powiadom mnie"
msgstr "Powiadom mnie"

#: src/Admin/ProUpsell.php:94
msgid "Get notified"
msgstr "Powiadom mnie"

#: src/Admin/ProUpsell.php:124
msgid "Permission denied."
msgstr "Brak uprawnień."

#. translators: %s: PRO edition name
#: src/Admin/ProUpsell.php:154
#, php-format
msgid "Do more with %s"
msgstr "Zrób więcej dzięki %s"

#: src/Admin/ProUpsell.php:161
msgid "Dismiss this notice"
msgstr "Odrzuć to powiadomienie"

#: src/Admin/ProUpsell.php:178
msgid "Unlock every PRO feature"
msgstr "Odblokuj wszystkie funkcje PRO"

#: src/Admin/ProUpsell.php:191
msgid "one licence, every PRO feature"
msgstr "jedna licencja, wszystkie funkcje PRO"

#. translators: %s: PRO edition name
#: src/Admin/ProUpsell.php:210
#, php-format
msgid "What %s adds"
msgstr "Co dodaje %s"

#: src/Admin/Settings.php:52 src/Admin/Settings.php:110
msgid "Atesto: Sales Notifications"
msgstr "Proof: Powiadomienia o sprzedaży"

#: src/Admin/Settings.php:53
msgid "Atesto"
msgstr "Proof"

#: src/Admin/Settings.php:114
msgid ""
"Show small popups of recent real purchases to build trust and urgency. Only "
"a first name and city are ever shown, never full names, emails or addresses."
msgstr ""
"Wyświetlaj niewielkie wyskakujące powiadomienia o niedawnych prawdziwych "
"zakupach, aby budować zaufanie i poczucie pilności. Pokazywane są wyłącznie "
"imię i miasto, nigdy pełne nazwiska, adresy e-mail ani adresy zamieszkania."

#: src/Admin/Settings.php:124
msgid "Save changes"
msgstr "Zapisz zmiany"

#: src/Admin/Settings.php:140
msgid "General"
msgstr "Ogólne"

#: src/Admin/Settings.php:145
msgid "Enable Atesto"
msgstr "Włącz Proof"

#: src/Admin/Settings.php:146
msgid ""
"Master switch. When off, no popups are loaded or rendered anywhere on the "
"storefront."
msgstr ""
"Główny przełącznik. Po wyłączeniu żadne powiadomienia nie są wczytywane ani "
"wyświetlane w żadnym miejscu sklepu."

#: src/Admin/Settings.php:152
msgid "Screen corner"
msgstr "Narożnik ekranu"

#: src/Admin/Settings.php:154
msgid "Bottom left"
msgstr "Lewy dolny"

#: src/Admin/Settings.php:155
msgid "Bottom right"
msgstr "Prawy dolny"

#: src/Admin/Settings.php:156
msgid "Top left"
msgstr "Lewy górny"

#: src/Admin/Settings.php:157
msgid "Top right"
msgstr "Prawy górny"

#: src/Admin/Settings.php:160
msgid "Which corner of the screen the popup slides in from."
msgstr "Z którego narożnika ekranu wsuwa się powiadomienie."

#: src/Admin/Settings.php:173
msgid "What each popup shows"
msgstr "Co wyświetla każde powiadomienie"

#: src/Admin/Settings.php:174
msgid ""
"Each popup shows the buyer's first name, billing city, the product name and "
"how long ago the purchase happened. Surnames, emails and full addresses are "
"never shown."
msgstr ""
"Każde wyskakujące okienko pokazuje imię kupującego, miasto rozliczenia, "
"nazwę produktu i czas temu, kiedy nastąpił zakup. Nazwiska, adresy e-mail i "
"pełne adresy nigdy nie są wyświetlane."

#: src/Admin/Settings.php:182
msgid "Fallback name"
msgstr "Nazwa zastępcza"

#: src/Admin/Settings.php:186
#, php-format
msgid ""
"Shown in place of a first name when the order has none. Leave blank to use "
"the default, “%s”."
msgstr "Pokazywana zamiast imienia, gdy zamówienie go nie ma. Zostaw puste, aby użyć domyślnej: \"%s\"."

#: src/Admin/Settings.php:187 src/Service/OrderFeed.php:130
msgid "Someone"
msgstr "Ktoś"

#: src/Admin/Settings.php:201
msgid "Timing"
msgstr "Czas wyświetlania"

#: src/Admin/Settings.php:204
msgid "Initial delay (seconds)"
msgstr "Początkowe opóźnienie (sekundy)"

#: src/Admin/Settings.php:204
msgid ""
"How long to wait after the page loads before the first popup appears. "
"Default 5 seconds."
msgstr ""
"Jak długo czekać po załadowaniu strony, zanim pojawi się pierwsze "
"wyskakujące okienko. Domyślnie 5 sekund."

#: src/Admin/Settings.php:205
msgid "Display time (seconds)"
msgstr "Czas wyświetlania (sekundy)"

#: src/Admin/Settings.php:205
msgid ""
"How long each popup stays on screen before sliding away. Default 6 seconds."
msgstr ""
"Jak długo każde wyskakujące okienko pozostaje na ekranie, zanim się zsunie. "
"Domyślnie 6 sekund."

#: src/Admin/Settings.php:206
msgid "Interval between popups (seconds)"
msgstr "Odstęp między powiadomieniami (sekundy)"

#: src/Admin/Settings.php:206
msgid ""
"Gap between one popup disappearing and the next appearing. Lower values show "
"more popups; higher values feel calmer. Default 12 seconds."
msgstr ""
"Przerwa między zniknięciem jednego wyskakującego okienka a pojawieniem się "
"następnego. Niższe wartości pokazują więcej wyskakujących okienek; wyższe "
"wartości sprawiają wrażenie spokojniejszych. Domyślnie 12 sekund."

#: src/Admin/Settings.php:219
msgid "Example"
msgstr "Przykład"

#: src/Admin/Settings.php:226
msgid "Alex from Berlin"
msgstr "Alex z Berlina"

#: src/Admin/Settings.php:226
msgid "bought Merino Hoodie"
msgstr "kupił(a) bluzę z kapturem Merino"

#: src/Admin/Settings.php:227
msgid "2 hours ago"
msgstr "2 godziny temu"

#: src/Admin/Settings.php:244
msgid "Enabled"
msgstr "Włączone"

#: src/Service/FrontendService.php:87
msgid "Recent purchase"
msgstr "Niedawny zakup"

#: src/Service/FrontendService.php:88
msgid "Dismiss notification"
msgstr "Zamknij powiadomienie"

#. translators: connects a name to a city, e.g. "Alex from Berlin".
#: src/Service/FrontendService.php:90
msgid "from"
msgstr "z"

#. translators: connects a buyer to a product, e.g. "bought Hoodie".
#: src/Service/FrontendService.php:92
msgid "bought"
msgstr "kupił(a)"

#. translators: %s: human-readable time difference, e.g. "2 hours".
#: src/Service/OrderFeed.php:177
#, php-format
msgid "%s ago"
msgstr "%s temu"

